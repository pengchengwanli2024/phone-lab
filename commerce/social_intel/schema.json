{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Commerce social intelligence v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "batch_id", "created_at", "scope", "records", "record_versions", "assets", "attempts", "events"],
  "properties": {
    "schema": {"const": "commerce-social-intelligence-v1"},
    "batch_id": {"$ref": "#/$defs/id"},
    "created_at": {"$ref": "#/$defs/time"},
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["categories", "top_per_category", "queries", "ranking_version", "limitations"],
      "properties": {
        "categories": {"type": "array", "items": {"enum": ["commerce", "ai", "news"]}, "minItems": 1},
        "top_per_category": {"type": "integer", "minimum": 1},
        "queries": {"type": "array", "items": {"$ref": "#/$defs/text"}},
        "ranking_version": {"$ref": "#/$defs/text"},
        "limitations": {"$ref": "#/$defs/text"}
      }
    },
    "records": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/record"}},
    "record_versions": {"type": "array", "maxItems": 20000, "items": {"$ref": "#/$defs/record"}},
    "assets": {"type": "array", "maxItems": 5000, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["evidence_id", "path", "sha256", "media_type", "captured_at", "locator"],
      "properties": {
        "evidence_id": {"$ref": "#/$defs/id"}, "path": {"$ref": "#/$defs/text"},
        "sha256": {"$ref": "#/$defs/hash"}, "media_type": {"$ref": "#/$defs/text"},
        "captured_at": {"$ref": "#/$defs/time"}, "locator": {"$ref": "#/$defs/text"}
      }
    }},
    "attempts": {"type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "platform", "query", "started_at", "ended_at", "status", "reason", "evidence_ids"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "platform": {"enum": ["x", "tiktok", "web"]},
        "query": {"$ref": "#/$defs/text"}, "started_at": {"$ref": "#/$defs/time"}, "ended_at": {"$ref": "#/$defs/time"},
        "status": {"enum": ["success", "partial", "empty", "blocked"]}, "reason": {"$ref": "#/$defs/text"},
        "evidence_ids": {"$ref": "#/$defs/ids"}
      }
    }},
    "events": {"type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "at", "type", "record_id", "content_sha256", "record_sha256", "result", "evidence_ids"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "at": {"$ref": "#/$defs/time"},
        "type": {"enum": ["observed", "source_attempt", "summary_reviewed", "link_attempt", "rechecked"]},
        "record_id": {"type": ["string", "null"]}, "content_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "record_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "result": {"$ref": "#/$defs/text"}, "evidence_ids": {"$ref": "#/$defs/ids"}
      }
    }}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,100}$"},
    "text": {"type": "string", "minLength": 1, "maxLength": 12000},
    "time": {"type": "string", "format": "date-time"},
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "ids": {"type": "array", "items": {"$ref": "#/$defs/id"}},
    "record": {
      "type": "object", "additionalProperties": false,
      "required": ["record_id", "category", "title_zh", "summary_zh", "source", "published", "captured_at", "original", "translation", "metrics", "verification", "limitations", "ranking", "next_action", "evidence_ids", "content_sha256", "record_sha256"],
      "properties": {
        "record_id": {"$ref": "#/$defs/id"}, "category": {"enum": ["commerce", "ai", "news"]},
        "title_zh": {"type": "string", "minLength": 1, "maxLength": 160},
        "summary_zh": {"type": "string", "minLength": 1, "maxLength": 2000},
        "source": {
          "type": "object", "additionalProperties": false,
          "required": ["platform", "url", "kind", "access"],
          "properties": {
            "platform": {"enum": ["x", "tiktok", "web"]},
            "url": {"type": ["string", "null"], "format": "uri"},
            "kind": {"enum": ["permalink", "profile", "search", "unavailable"]},
            "access": {"enum": ["observed", "indexed_only", "unavailable"]}
          }
        },
        "published": {
          "type": "object", "additionalProperties": false,
          "required": ["display", "iso", "precision"],
          "properties": {"display": {"$ref": "#/$defs/text"}, "iso": {"type": ["string", "null"], "format": "date-time"}, "precision": {"enum": ["exact", "day", "relative", "unknown"]}}
        },
        "captured_at": {"$ref": "#/$defs/time"},
        "original": {
          "type": "object", "additionalProperties": false,
          "required": ["text", "language", "method", "locator", "evidence_id"],
          "properties": {"text": {"$ref": "#/$defs/text"}, "language": {"$ref": "#/$defs/text"}, "method": {"enum": ["ocr", "accessibility", "manual_excerpt"]}, "locator": {"$ref": "#/$defs/text"}, "evidence_id": {"$ref": "#/$defs/id"}}
        },
        "translation": {
          "type": "object", "additionalProperties": false,
          "required": ["zh", "method", "review_status", "original_sha256"],
          "properties": {"zh": {"$ref": "#/$defs/text"}, "method": {"enum": ["assistant", "manual", "source_chinese"]}, "review_status": {"enum": ["pending", "reviewed"]}, "original_sha256": {"$ref": "#/$defs/hash"}}
        },
        "metrics": {"type": "array", "items": {
          "type": "object", "additionalProperties": false,
          "required": ["name", "display", "value", "approximate", "observed_at", "evidence_id"],
          "properties": {"name": {"enum": ["likes", "views", "comments", "shares", "saves", "sales"]}, "display": {"$ref": "#/$defs/text"}, "value": {"type": ["number", "null"], "minimum": 0}, "approximate": {"type": "boolean"}, "observed_at": {"$ref": "#/$defs/time"}, "evidence_id": {"$ref": "#/$defs/id"}}
        }},
        "verification": {"enum": ["observed_not_verified", "corroborated", "conflict", "unknown"]},
        "limitations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}},
        "ranking": {
          "type": "object", "additionalProperties": false,
          "required": ["selected", "rank", "reason", "rule_version", "basis_sha256"],
          "properties": {"selected": {"type": "boolean"}, "rank": {"type": ["integer", "null"], "minimum": 1}, "reason": {"$ref": "#/$defs/text"}, "rule_version": {"$ref": "#/$defs/text"}, "basis_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}}
        },
        "next_action": {"$ref": "#/$defs/text"},
        "evidence_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id"}},
        "content_sha256": {"$ref": "#/$defs/hash"},
        "record_sha256": {"$ref": "#/$defs/hash"}
      }
    }
  }
}
